# Configuration Production MED Backend
# Copier ce fichier en .env et modifier les valeurs

# Port externe du backend (accessible depuis l'extérieur)
BACKEND_PORT=9085

# PostgreSQL
POSTGRES_DB=med_db
POSTGRES_USER=med_user
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_SECURISE

# JWT Secret (min 256 bits / 32 caractères)
JWT_SECRET=CHANGEZ_CETTE_CLE_SECRETE_TRES_LONGUE_ET_SECURISEE_2024

# Email (Gmail SMTP)
MAIL_PASSWORD=votre_app_password_gmail

# Cloudinary (pour les images)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
